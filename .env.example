# Typeform Configuration
# Replace with your actual Typeform form ID
NEXT_PUBLIC_TYPEFORM_ID=bfpkatKE

# Environment
NEXT_PUBLIC_ENVIRONMENT=development

# Analytics Configuration
# Google Analytics Measurement ID
NEXT_PUBLIC_GA_ID=G-Q2EVCVX7H9

# Facebook Pixel ID
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=your-facebook-pixel-id-here

# ============================================================================
# SUPABASE CONFIGURATION (for trial requests)
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ============================================================================
# PAYMENT PROXY CONFIGURATION (optional - if using PhonePe payments)
# ============================================================================
# Payment Proxy URL (experiences.beforest.co)
PAYMENT_PROXY_URL=https://experiences.beforest.co/api/payment-proxy/initiate

# API Key for authenticating with the payment proxy
PAYMENT_PROXY_API_KEY=your_secure_api_key_here

# Experiences trial checkout bridge
EXPERIENCES_CHECKOUT_CREATE_URL=https://experiences.beforest.co/api/trial-booking-requests
EXPERIENCES_API_KEY=your_shared_10cent_to_experiences_api_key
TRIAL_PAYMENT_WEBHOOK_SECRET=your_shared_experiences_to_10cent_hmac_secret

# Optional: set to 1 only while doing an end-to-end payment smoke test.
# Remove this in production so checkout uses the live eZee room amount.
# You can also use /trial-booking/test for a short-lived browser-only ₹1 test session.
TRIAL_CHECKOUT_AMOUNT_OVERRIDE=

# Base URL for this site (10percent.beforest.co)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# PhonePe Environment (for reference only - credentials are on experiences site)
NEXT_PUBLIC_PHONEPE_ENV=UAT

# ============================================================================
# EZEE / YCS API (Blyton booking engine)
# ============================================================================
EZEE_HOTEL_CODE=45477
EZEE_AUTH_CODE=your_ezee_auth_code
EZEE_USER_AGENT=openAPI-BlytonBungalow
EZEE_PAYMENT_TYPE_UNKID=4547700000000000184

# Keep false until the team is ready for API-created bookings to block live
# inventory in eZee. Availability checks work without enabling this.
EZEE_ENABLE_TRIAL_BLOCKING=false
